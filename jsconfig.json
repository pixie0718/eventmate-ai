{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "checkJs": true,
    "allowJs": true,
    "noEmit": true,
    "skipLibCheck": true,
    "maxNodeModuleJsDepth": 0,
    "strictNullChecks": true,
    "noImplicitAny": false
  },
  "include": ["js/**/*.js", "api/**/*.js", "netlify/**/*.js", "scripts/**/*.js", "server.js"]
}
