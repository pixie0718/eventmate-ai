{
  "name": "eventmate-ai",
  "version": "1.0.0",
  "description": "Planning assistant for weddings, birthdays and community events, with an optional server-side AI layer.",
  "type": "module",
  "private": true,
  "license": "MIT",
  "scripts": {
    "test": "node --test \"tests/*.test.js\"",
    "start": "node server.js",
    "lint": "eslint .",
    "typecheck": "tsc -p jsconfig.json",
    "check": "npm run lint && npm run typecheck && npm test",
    "test:coverage": "node --test --experimental-test-coverage \"tests/*.test.js\""
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "axe-core": "^4.14.0",
    "eslint": "^10.14.0",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "typescript": "^7.0.2"
  }
}
